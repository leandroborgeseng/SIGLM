{
  "name": "leis-municipais",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de Legislação Municipal — Prefeitura de Franca/SP",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@leis-municipais/api",
    "dev:web": "npm run dev --workspace=@leis-municipais/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=@leis-municipais/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@leis-municipais/api",
    "db:seed": "npm run db:seed --workspace=@leis-municipais/api",
    "db:reset": "npm run db:reset --workspace=@leis-municipais/api",
    "smoke": "API_URL=${API_URL:-http://localhost:3001/api} WEB_URL=${WEB_URL:-http://localhost:3000} ./scripts/smoke-test.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
