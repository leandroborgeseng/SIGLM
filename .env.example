# ─── Desenvolvimento local ───────────────────────────────────────────────────
DATABASE_URL="postgresql://leis_municipais:leis_municipais_dev@localhost:5433/leis_municipais?schema=public"
API_PORT=3001
JWT_SECRET=altere-em-producao-use-uma-chave-longa-e-aleatoria
JWT_REFRESH_SECRET=altere-em-producao-refresh-token-secreto
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Docker Compose (docker-compose.prod.yml) ─────────────────────────────────
POSTGRES_USER=leis_municipais
POSTGRES_PASSWORD=altere-senha-forte-postgres
POSTGRES_DB=leis_municipais
CORS_ORIGIN=http://localhost:3000
RUN_SEED=false

# Web — SSR/proxy em runtime (Railway: rede privada, sem egress)
API_INTERNAL_URL=http://backend.railway.internal:3001/api
# Web — dev local direto na API
API_URL=http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
