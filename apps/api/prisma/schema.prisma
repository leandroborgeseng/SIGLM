generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth / RBAC ───────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  hashSenha String   @map("hash_senha")
  roleId    String   @map("role_id")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role              Role              @relation(fields: [roleId], references: [id])
  normativeChanges  NormativeChange[]
  imports           Import[]
  ocrReviews        OcrResult[]       @relation("OcrReviewer")
  auditLogs         AuditLog[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  nome        String           @unique
  descricao   String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid())
  chave String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OriginOrg {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  acts NormativeAct[]

  @@map("origin_orgs")
}

// ─── Normas ──────────────────────────────────────────────────────────────────

enum ActType {
  lei_complementar
  lei
  decreto
  portaria
  resolucao
  instrucao_normativa
}

enum ActSituacao {
  vigente
  revogado
  parcialmente_revogado
  alterado
  consolidado
}

enum PublicationStatus {
  rascunho
  em_revisao
  publicado
}

model NormativeAct {
  id                  String            @id @default(uuid())
  tipo                ActType
  numero              Int
  ano                 Int
  dataAto             DateTime?         @map("data_ato") @db.Date
  dataPublicacao      DateTime?         @map("data_publicacao") @db.Date
  ementa              String
  assunto             String?
  palavrasChave       String[]          @default([]) @map("palavras_chave")
  situacao            ActSituacao       @default(vigente)
  orgaoOrigem         String?           @map("orgao_origem")
  orgaoOrigemId       String?           @map("orgao_origem_id")
  autoridadeSignataria String?          @map("autoridade_signataria")
  slug                String            @unique
  observacoesInternas String?           @map("observacoes_internas") @db.Text
  statusPublicacao    PublicationStatus @default(rascunho) @map("status_publicacao")
  searchVector        Unsupported("tsvector")? @map("search_vector")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  orgao              OriginOrg?        @relation(fields: [orgaoOrigemId], references: [id], onDelete: SetNull)
  units              NormativeUnit[]
  attachments        Attachment[]
  imports            Import[]
  changesAsAlteradora NormativeChange[] @relation("NormaAlteradora")
  changesAsAlterada  NormativeChange[] @relation("NormaAlterada")
  unitsOrigem        NormativeUnit[]   @relation("UnitOrigemAct")
  unitsAlteradoPor   NormativeUnit[]   @relation("UnitAlteradoPorAct")
  versionsOrigem     NormativeVersion[] @relation("VersionOrigemAct")
  legislativeEffectsTarget LegislativeEffect[] @relation("EffectNormaAlterada")

  @@unique([tipo, numero, ano])
  @@index([tipo, ano, numero])
  @@index([situacao])
  @@index([statusPublicacao])
  @@index([orgaoOrigemId])
  @@map("normative_acts")
}

enum UnitType {
  parte
  livro
  titulo
  subtitulo
  capitulo
  subcapitulo
  secao
  subsecao
  artigo
  paragrafo_unico
  paragrafo
  inciso
  alinea
  item
  anexo
  preambulo
  considerando
  ementa
}

enum UnitStatus {
  vigente
  revogada
  revogada_parcialmente
  alterada
  incluida
}

model NormativeUnit {
  id               String     @id @default(uuid())
  actId            String     @map("act_id")
  tipoUnidade      UnitType   @map("tipo_unidade")
  identificacao    String?
  texto            String     @db.Text
  ordem            Int
  parentUnitId     String?    @map("parent_unit_id")
  status           UnitStatus @default(vigente)
  origemActId      String?    @map("origem_act_id")
  alteradoPorActId String?    @map("alterado_por_act_id")
  dataAlteracao    DateTime?  @map("data_alteracao") @db.Date
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  act            NormativeAct      @relation(fields: [actId], references: [id], onDelete: Cascade)
  parentUnit     NormativeUnit?    @relation("UnitHierarchy", fields: [parentUnitId], references: [id])
  childUnits     NormativeUnit[]   @relation("UnitHierarchy")
  origemAct      NormativeAct?     @relation("UnitOrigemAct", fields: [origemActId], references: [id])
  alteradoPorAct NormativeAct?     @relation("UnitAlteradoPorAct", fields: [alteradoPorActId], references: [id])
  versions       NormativeVersion[]
  changes        NormativeChange[]
  legislativeEffectsSource LegislativeEffect[] @relation("EffectSource")
  legislativeEffectsTarget LegislativeEffect[] @relation("EffectTarget")
  legislativeEffectsReferencia LegislativeEffect[] @relation("EffectReferencia")
  legislativeEffectsRedacao LegislativeEffect[] @relation("EffectRedacao")

  @@index([actId, ordem])
  @@index([parentUnitId])
  @@map("normative_units")
}

model NormativeVersion {
  id           String    @id @default(uuid())
  unitId       String    @map("unit_id")
  texto        String    @db.Text
  validoDe     DateTime  @map("valido_de") @db.Date
  validoAte    DateTime? @map("valido_ate") @db.Date
  origemActId  String?   @map("origem_act_id")
  criadoEm     DateTime  @default(now()) @map("criado_em")

  unit      NormativeUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  origemAct NormativeAct?  @relation("VersionOrigemAct", fields: [origemActId], references: [id])

  @@index([unitId, validoDe])
  @@map("normative_versions")
}

enum ChangeType {
  inclusao
  alteracao_redacao
  revogacao_parcial
  revogacao_total
  renumeracao
}

enum EffectType {
  alteracao_redacao
  inclusao
  revogacao_total
  revogacao_parcial
  renumeracao
}

enum InclusaoPosicionamento {
  antes_de
  apos
  dentro_de
}

model NormativeChange {
  id                    String     @id @default(uuid())
  normaAlteradoraActId  String     @map("norma_alteradora_act_id")
  normaAlteradaActId    String     @map("norma_alterada_act_id")
  unitId                String?    @map("unit_id")
  tipoAlteracao         ChangeType @map("tipo_alteracao")
  textoAnterior         String?    @map("texto_anterior") @db.Text
  textoNovo             String?    @map("texto_novo") @db.Text
  notaGerada            String?    @map("nota_gerada")
  fundamento            String?
  data                  DateTime   @db.Date
  autorId               String?    @map("autor_id")
  createdAt             DateTime   @default(now()) @map("created_at")

  normaAlteradora NormativeAct  @relation("NormaAlteradora", fields: [normaAlteradoraActId], references: [id])
  normaAlterada   NormativeAct  @relation("NormaAlterada", fields: [normaAlteradaActId], references: [id])
  unit            NormativeUnit? @relation(fields: [unitId], references: [id])
  autor           User?         @relation(fields: [autorId], references: [id])

  @@index([normaAlteradaActId])
  @@index([normaAlteradoraActId])
  @@map("normative_changes")
}

model LegislativeEffect {
  id                      String                  @id @default(uuid())
  sourceUnitId            String                  @map("source_unit_id")
  normaAlteradaActId      String                  @map("norma_alterada_act_id")
  targetUnitId            String?                 @map("target_unit_id")
  tipoEfeito              EffectType              @map("tipo_efeito")
  dataVigencia            DateTime                @map("data_vigencia") @db.Date
  observacoes             String?                 @db.Text
  tipoDispositivoIncluido UnitType?               @map("tipo_dispositivo_incluido")
  posicionamento          InclusaoPosicionamento?
  referenciaUnitId        String?                 @map("referencia_unit_id")
  textoNovo               String?                 @map("texto_novo") @db.Text
  redacaoUnitId           String?                 @map("redacao_unit_id")
  novaIdentificacao       String?                 @map("nova_identificacao")
  ordem                   Int                     @default(0)
  appliedAt               DateTime?               @map("applied_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  sourceUnit     NormativeUnit  @relation("EffectSource", fields: [sourceUnitId], references: [id], onDelete: Cascade)
  normaAlterada  NormativeAct   @relation("EffectNormaAlterada", fields: [normaAlteradaActId], references: [id])
  targetUnit     NormativeUnit? @relation("EffectTarget", fields: [targetUnitId], references: [id])
  referenciaUnit NormativeUnit? @relation("EffectReferencia", fields: [referenciaUnitId], references: [id])
  redacaoUnit    NormativeUnit? @relation("EffectRedacao", fields: [redacaoUnitId], references: [id])

  @@index([sourceUnitId])
  @@index([normaAlteradaActId])
  @@map("legislative_effects")
}

// ─── Arquivos e importação ───────────────────────────────────────────────────

enum AttachmentType {
  pdf_original
  digitalizado
  anexo
}

model Attachment {
  id        String         @id @default(uuid())
  actId     String         @map("act_id")
  tipo      AttachmentType
  url       String
  nome      String
  tamanho   Int?
  hash      String?
  criadoEm  DateTime       @default(now()) @map("criado_em")

  act NormativeAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@index([actId])
  @@map("attachments")
}

enum ImportFormat {
  doc
  docx
  pdf
  pdf_ocr
}

enum ImportStatus {
  upload
  processando
  conferencia
  rascunho
  publicado
  erro
}

model Import {
  id                 String       @id @default(uuid())
  actId              String?      @map("act_id")
  arquivo            String
  formato            ImportFormat
  lib                String?
  status             ImportStatus @default(upload)
  estruturaDetectada Json?        @map("estrutura_detectada")
  criadoPorId        String?      @map("criado_por")
  criadoEm           DateTime     @default(now()) @map("criado_em")

  act       NormativeAct? @relation(fields: [actId], references: [id])
  criadoPor User?         @relation(fields: [criadoPorId], references: [id])
  ocrResults OcrResult[]

  @@map("imports")
}

model OcrResult {
  id           String    @id @default(uuid())
  importId     String    @map("import_id")
  pagina       Int
  texto        String    @db.Text
  confianca    Json
  revisadoPorId String?  @map("revisado_por")
  revisadoEm   DateTime? @map("revisado_em")

  import      Import @relation(fields: [importId], references: [id], onDelete: Cascade)
  revisadoPor User?  @relation("OcrReviewer", fields: [revisadoPorId], references: [id])

  @@index([importId, pagina])
  @@map("ocr_results")
}

// ─── Auditoria ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  diff       Json?
  ip         String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  user User? @relation(fields: [userId], references: [id])

  @@index([entidade, entidadeId])
  @@index([userId])
  @@index([criadoEm])
  @@map("audit_logs")
}
