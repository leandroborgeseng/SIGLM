# Copie para restic.env e preencha (NÃO commitar restic.env).
# cp scripts/backup/restic.env.example scripts/backup/restic.env

# ─── Restic (destino do backup) ───────────────────────────────────────────────
# Exemplos de RESTIC_REPOSITORY:
#   s3:s3.amazonaws.com/meu-bucket/siglm
#   s3:https://minio.example.com/meu-bucket/siglm
#   sftp:user@backup-server:/backups/siglm
#   /mnt/backups/restic/siglm          (disco local ou NFS)
#   rclone:remote:siglm                (requer restic + rclone configurado)

RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# S3 / MinIO (se usar backend S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# SFTP (se usar backend SFTP)
# RESTIC_SFTP_USER=
# RESTIC_SFTP_PASS=

# ─── Aplicação (Docker Compose) ─────────────────────────────────────────────
# Caminho absoluto da raiz do repo no servidor Coolify/VPS
SIGLM_ROOT=/data/coolify/applications/SIGLM

COMPOSE_FILE=docker-compose.coolify.yml
COMPOSE_PROJECT_NAME=

# Postgres (deve coincidir com o compose)
POSTGRES_USER=siglm
POSTGRES_DB=siglm
POSTGRES_SERVICE=postgres
API_SERVICE=api

# Diretório temporário para montar o snapshot antes do restic
# Recomendado: disco local rápido com espaço >= 2× tamanho do banco + uploads
BACKUP_STAGING=/var/lib/siglm-backup/staging

# Tags restic
RESTIC_TAG=siglm

# Retenção (restic forget)
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=12
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=2

# Opcional: notificação (comando executado após sucesso/falha)
# BACKUP_NOTIFY_CMD='curl -s -X POST ...'
