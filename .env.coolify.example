# Variáveis para docker-compose.coolify.yml — cole no Coolify (Environment).
# Não commitar com valores reais.
#
# Coolify: marque CADA variável como "Available at Buildtime" (Build Variable).

# Banco (interno ao compose)
POSTGRES_USER=siglm
POSTGRES_PASSWORD=senha-forte-aqui
POSTGRES_DB=siglm

# Segurança — openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# URL pública do PORTAL (CORS) — https, sem barra final
CORS_ORIGIN=https://legislacao.seudominio.gov.br

# URL pública da API — com /api no final
NEXT_PUBLIC_API_URL=https://api.seudominio.gov.br/api

# true no 1º deploy demo; depois mude para false no Coolify
RUN_SEED=true

# --- Ambiente de demonstração ---
# NEXT_PUBLIC_STAGING_GATE: marque Build Variable no Coolify
NEXT_PUBLIC_STAGING_GATE=true
STAGING_ACCESS_PASSWORD=siglm-demo

# --- Backup automático S3 ---
# Prefira configurar pela interface: Administração → Backup e migração.
# As variáveis abaixo são opcionais (importação única se a UI ainda estiver vazia).
# S3_BACKUP_ENABLED=false
# S3_BACKUP_BUCKET=
# S3_BACKUP_REGION=us-east-1
# S3_BACKUP_ACCESS_KEY_ID=
# S3_BACKUP_SECRET_ACCESS_KEY=
